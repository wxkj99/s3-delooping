{-# OPTIONS --safe --cubical #-}

-- Shear coordinate changes for the local quotient and its boundary maps.
-- The discrete groups are set quotients; their classifying spaces are full EM₁ types.
module DeloopS3.Move.ShearFormula where

open import Cubical.Foundations.Prelude
open import Cubical.Foundations.Function
open import Cubical.Foundations.Equiv
open import Cubical.Foundations.Isomorphism
open import Cubical.Foundations.HLevels
open import Cubical.Data.Sigma
open import Cubical.Data.Nat using (ℕ)
open import Cubical.Data.Nat.Order using (_<_)
open import Cubical.Data.Int
open import Cubical.Algebra.Group.Base
open import Cubical.Algebra.Group.Morphisms
open import Cubical.Algebra.Group.MorphismProperties
open import Cubical.Algebra.Group.QuotientGroup using (Hom/ImIso)
open import Cubical.Algebra.Group.Instances.Int using (ℤGroup; ℤHom)
open import Cubical.Algebra.AbGroup.Base
open import Cubical.Algebra.AbGroup.Properties using (_/Im_; addGroupHom; module AbGroupTheory)
open import Cubical.Algebra.AbGroup.Instances.Int using (ℤAbGroup)
open import Cubical.Algebra.AbGroup.Instances.DirectProduct using (AbDirProd)
import Cubical.HITs.SetQuotients as SQ
import Cubical.HITs.PropositionalTruncation as PT
open import Cubical.Algebra.Group.ZAction using (_ℤ[_]·_; homPresℤ·; rUnitℤ·ℤ)
open import Cubical.HITs.EilenbergMacLane1.Base
import Cubical.HITs.EilenbergMacLane1.Properties as EM₁
open import Cubical.Homotopy.EilenbergMacLane.Properties
  using (inducedFun-EM₁; inducedFun-EM₁-comp; Iso→EM₁Iso;
         inducedFun-EM; inducedFun-EM-pres+ₖ)
open import Cubical.Homotopy.EilenbergMacLane.GroupStructure
  using (_+ₖ_; cong₂+₁; assocₖ; commₖ; addIso)
open import DeloopS3.Move.CancelMinimal using (C; T²; _+C_; mulC)
open import DeloopS3.Move.CancelMinimalCore using (EquivOver)

ℤ²Ab : AbGroup ℓ-zero
ℤ²Ab = AbDirProd ℤAbGroup ℤAbGroup

ℤ²Group : Group ℓ-zero
ℤ²Group = AbGroup→Group ℤ²Ab

-- The image is precisely the subgroup generated by (d,-s).
relationHom : (d : ℕ) (s : ℤ) → GroupHom ℤGroup ℤ²Group
relationHom d s .fst n = pos d · n , (- s) · n
relationHom d s .snd = makeIsGroupHom λ n m →
  ΣPathP (·DistR+ (pos d) n m , ·DistR+ (- s) n m)

AAb : ℕ → ℤ → AbGroup ℓ-zero
AAb d s = ℤ²Ab /Im relationHom d s

A : ℕ → ℤ → Group ℓ-zero
A d s = AbGroup→Group (AAb d s)

-- Concretely the library's relation is
--   x ~ y = ∥ Σ n : ℤ, (d*n,(-s)*n) = x-y ∥₁.
-- This is the set quotient by <(d,-s)>, not a presentation 2-complex.
class : (d : ℕ) (s : ℤ) → ℤ × ℤ → A d s .fst
class d s = SQ.[_]

quotientHom : (d : ℕ) (s : ℤ) → GroupHom ℤ²Group (A d s)
quotientHom d s .fst = class d s
quotientHom d s .snd = makeIsGroupHom λ _ _ → refl

shearParameter : ℕ → ℤ → ℤ → ℤ
shearParameter d s κ = s - pos d · κ

-- The two literal integral coordinate maps, before taking quotients.
shearCoordinates : ℤ → ℤ × ℤ → ℤ × ℤ
shearCoordinates κ (a , b) = a , b + κ · a

unshearCoordinates : ℤ → ℤ × ℤ → ℤ × ℤ
unshearCoordinates κ (a , b) = a , b - κ · a

shearCoordinates-add : (κ : ℤ) (x y : ℤ × ℤ)
  → shearCoordinates κ (GroupStr._·_ (ℤ²Group .snd) x y)
    ≡ GroupStr._·_ (ℤ²Group .snd) (shearCoordinates κ x) (shearCoordinates κ y)
shearCoordinates-add κ (a , b) (c , e) = ΣPathP (refl ,
  (cong ((b + e) +_) (·DistR+ κ a c)
    ∙ AbGroupTheory.comm-4 ℤAbGroup b e (κ · a) (κ · c)))

shearCoordinates-sec : (κ : ℤ) (x : ℤ × ℤ)
  → shearCoordinates κ (unshearCoordinates κ x) ≡ x
shearCoordinates-sec κ (a , b) = ΣPathP (refl ,
  (sym (+Assoc b (- (κ · a)) (κ · a))
    ∙ cong (b +_) (-Cancel' (κ · a))))

shearCoordinates-ret : (κ : ℤ) (x : ℤ × ℤ)
  → unshearCoordinates κ (shearCoordinates κ x) ≡ x
shearCoordinates-ret κ (a , b) = ΣPathP (refl ,
  (sym (+Assoc b (κ · a) (- (κ · a)))
    ∙ cong (b +_) (-Cancel (κ · a))))

shearCoordinatesIso : (κ : ℤ) → GroupIso ℤ²Group ℤ²Group
shearCoordinatesIso κ .fst = iso (shearCoordinates κ) (unshearCoordinates κ)
  (shearCoordinates-sec κ) (shearCoordinates-ret κ)
shearCoordinatesIso κ .snd = makeIsGroupHom (shearCoordinates-add κ)

-- -(s-dκ)*n = -s*n + κ*(d*n), including the sign.
relation-shear-coordinate : (d s κ n : ℤ)
  → (- (s - d · κ)) · n ≡ (- s) · n + κ · (d · n)
relation-shear-coordinate d s κ n =
  cong (_· n) (-Dist+ s (- (d · κ))
    ∙ cong ((- s) +_) (-Involutive (d · κ)))
  ∙ ·DistL+ (- s) (d · κ) n
  ∙ cong (((- s) · n) +_)
      (cong (_· n) (·Comm d κ) ∙ sym (·Assoc κ d n))

relation-shear : (d : ℕ) (s κ n : ℤ)
  → relationHom d (shearParameter d s κ) .fst n
    ≡ shearCoordinates κ (relationHom d s .fst n)
relation-shear d s κ n = ΣPathP (refl , relation-shear-coordinate (pos d) s κ n)

-- The stronger statement also works at d=0; positivity is only needed
-- to interpret the base quotient as a finite cyclic group.
shearGroupIso-all : (d : ℕ) (s κ : ℤ)
  → GroupIso (A d s) (A d (shearParameter d s κ))
shearGroupIso-all d s κ = Hom/ImIso (relationHom d s)
  (relationHom d (shearParameter d s κ)) idGroupIso
  (shearCoordinatesIso κ) (relation-shear d s κ)

shearGroupIso : (d : ℕ) → 0 < d → (s κ : ℤ)
  → GroupIso (A d s) (A d (s - pos d · κ))
shearGroupIso d positive = shearGroupIso-all d

module Shear (d : ℕ) (s κ : ℤ) where
  s′ : ℤ
  s′ = shearParameter d s κ

  ΦHom : GroupHom (A d s) (A d s′)
  ΦHom = GroupIso→GroupHom (shearGroupIso-all d s κ)

  ΨHom : GroupHom (A d s′) (A d s)
  ΨHom = GroupIso→GroupHom (invGroupIso (shearGroupIso-all d s κ))

  Φ : A d s .fst → A d s′ .fst
  Φ = ΦHom .fst

  Ψ : A d s′ .fst → A d s .fst
  Ψ = ΨHom .fst

  Φ-class : (a b : ℤ) → Φ (class d s (a , b)) ≡ class d s′ (a , b + κ · a)
  Φ-class a b = refl

  Ψ-class : (a b : ℤ) → Ψ (class d s′ (a , b)) ≡ class d s (a , b - κ · a)
  Ψ-class a b = refl

  ΦΨ : (x : A d s′ .fst) → Φ (Ψ x) ≡ x
  ΦΨ = shearGroupIso-all d s κ .fst .Iso.sec

  ΨΦ : (x : A d s .fst) → Ψ (Φ x) ≡ x
  ΨΦ = shearGroupIso-all d s κ .fst .Iso.ret

-- C_d is explicitly the residue group ℤ/dℤ, using the same set-quotient
-- model rather than choosing representatives in Fin d.
CyclicAb : ℕ → AbGroup ℓ-zero
CyclicAb d = ℤAbGroup /Im ℤHom (pos d)

Cyclic : ℕ → Group ℓ-zero
Cyclic d = AbGroup→Group (CyclicAb d)

mod-d : (d : ℕ) → ℤ → Cyclic d .fst
mod-d d = SQ.[_]

projection : (d : ℕ) (s : ℤ) → A d s .fst → Cyclic d .fst
projection d s = SQ.rec SQ.squash/ (λ x → mod-d d (x .fst))
  (λ x y r → SQ.eq/ _ _ (PT.map (λ { (n , p) → n , cong fst p }) r))

projectionHom : (d : ℕ) (s : ℤ) → GroupHom (A d s) (Cyclic d)
projectionHom d s .fst = projection d s
projectionHom d s .snd = makeIsGroupHom
  (SQ.elimProp2 (λ _ _ → SQ.squash/ _ _) (λ _ _ → refl))

projection-class : (d : ℕ) (s a b : ℤ)
  → projection d s (class d s (a , b)) ≡ mod-d d a
projection-class d s a b = refl

shear-projection : (d : ℕ) (s κ : ℤ) (x : A d s .fst)
  → projection d (shearParameter d s κ) (Shear.Φ d s κ x) ≡ projection d s x
shear-projection d s κ = SQ.elimProp (λ _ → SQ.squash/ _ _) (λ _ → refl)

z h : (d : ℕ) (s : ℤ) → A d s .fst
z d s = class d s (1 , 0)
h d s = class d s (0 , 1)

-- hPower is the integer fibre homomorphism, so hPower 1 is h.
hPower : (d : ℕ) (s : ℤ) → ℤ → A d s .fst
hPower d s n = class d s (0 , n)

hPowerHom : (d : ℕ) (s : ℤ) → GroupHom ℤGroup (A d s)
hPowerHom d s .fst = hPower d s
hPowerHom d s .snd = makeIsGroupHom λ _ _ → refl

shear-z : (d : ℕ) (s κ : ℤ)
  → Shear.Φ d s κ (z d s)
    ≡ GroupStr._·_ (A d (shearParameter d s κ) .snd)
        (z d (shearParameter d s κ)) (hPower d (shearParameter d s κ) κ)
shear-z d s κ = cong (class d (shearParameter d s κ))
  (ΣPathP (refl , cong (0 +_) (·IdR κ)))

shear-hPower : (d : ℕ) (s κ n : ℤ)
  → Shear.Φ d s κ (hPower d s n) ≡ hPower d (shearParameter d s κ) n
shear-hPower d s κ n = cong (class d (shearParameter d s κ))
  (ΣPathP (refl , cong (n +_) (·AnnihilR κ)))

shear-h : (d : ℕ) (s κ : ℤ)
  → Shear.Φ d s κ (h d s) ≡ h d (shearParameter d s κ)
shear-h d s κ = shear-hPower d s κ 1

zPowerHom : (d : ℕ) (s : ℤ) → GroupHom ℤGroup (A d s)
zPowerHom d s .fst n = class d s (n , 0)
zPowerHom d s .snd = makeIsGroupHom λ _ _ → refl

-- These coordinate homomorphisms really are integer powers of z and h.
fibre-powers : (d : ℕ) (s n : ℤ)
  → (n ℤ[ A d s ]· h d s) ≡ hPower d s n
fibre-powers d s n = sym (homPresℤ· (hPowerHom d s) 1 n)
  ∙ cong (hPower d s) (rUnitℤ·ℤ n)

base-powers : (d : ℕ) (s n : ℤ)
  → (n ℤ[ A d s ]· z d s) ≡ class d s (n , 0)
base-powers d s n = sym (homPresℤ· (zPowerHom d s) 1 n)
  ∙ cong (zPowerHom d s .fst) (rUnitℤ·ℤ n)

relation-class : (d : ℕ) (s : ℤ)
  → class d s (pos d , 0) ≡ class d s (0 , s)
relation-class d s = SQ.eq/ _ _ PT.∣ 1 ,
  ΣPathP (·IdR (pos d) , ·IdR (- s) ∙ sym (+Comm 0 (- s))) ∣₁

-- The advertised relation z^d = h^s in the actual quotient group.
generator-relation : (d : ℕ) (s : ℤ)
  → (pos d ℤ[ A d s ]· z d s) ≡ (s ℤ[ A d s ]· h d s)
generator-relation d s = base-powers d s (pos d)
  ∙ relation-class d s ∙ sym (fibre-powers d s s)

-- Applying the EM₁ functor to the specified maps and inverse equations.
BA : ℕ → ℤ → Type₀
BA d s = EM₁ (A d s)

BC : ℕ → Type₀
BC d = EM₁ (Cyclic d)

Bprojection : (d : ℕ) (s : ℤ) → BA d s → BC d
Bprojection d s = inducedFun-EM₁ (projectionHom d s)

BΦ : (d : ℕ) (s κ : ℤ) → BA d s → BA d (shearParameter d s κ)
BΦ d s κ = inducedFun-EM₁ (Shear.ΦHom d s κ)

BΨ : (d : ℕ) (s κ : ℤ) → BA d (shearParameter d s κ) → BA d s
BΨ d s κ = inducedFun-EM₁ (Shear.ΨHom d s κ)

shearEMEquiv : (d : ℕ) (s κ : ℤ) → BA d s ≃ BA d (shearParameter d s κ)
shearEMEquiv d s κ = isoToEquiv (Iso→EM₁Iso (shearGroupIso-all d s κ))

shearEM-over : (d : ℕ) (s κ : ℤ)
  → EquivOver (Bprojection d s) (Bprojection d (shearParameter d s κ))
shearEM-over d s κ = shearEMEquiv d s κ ,
  EM₁.elimSet (A d s) (λ _ → emsquash _ _) refl
    (λ a i j → emloop (shear-projection d s κ a (~ j)) i)

shearEM-fibre : (d : ℕ) (s κ : ℤ)
  → cong (BΦ d s κ) (emloop (h d s)) ≡ emloop (h d (shearParameter d s κ))
shearEM-fibre d s κ = cong emloop (shear-h d s κ)

-- The boundary in the equivalent EM₁(ℤ²) model: all maps are induced by
-- the explicit homomorphisms, not reconstructed from abstract π₁ data.
BT² : Type₀
BT² = EM₁ ℤ²Group

Bquotient : (d : ℕ) (s : ℤ) → BT² → BA d s
Bquotient d s = inducedFun-EM₁ (quotientHom d s)

BTκ : ℤ → BT² → BT²
BTκ κ = inducedFun-EM₁ (GroupIso→GroupHom (shearCoordinatesIso κ))

boundaryHom-square : (d : ℕ) (s κ : ℤ)
  → compGroupHom (quotientHom d s) (Shear.ΦHom d s κ)
    ≡ compGroupHom (GroupIso→GroupHom (shearCoordinatesIso κ))
        (quotientHom d (shearParameter d s κ))
boundaryHom-square d s κ = GroupHom≡ refl

shearBoundary-EM₁ : (d : ℕ) (s κ : ℤ)
  → BΦ d s κ ∘ Bquotient d s
    ≡ Bquotient d (shearParameter d s κ) ∘ BTκ κ
shearBoundary-EM₁ d s κ = funExt λ x →
  sym (inducedFun-EM₁-comp (quotientHom d s) (Shear.ΦHom d s κ) x)
  ∙ cong (λ f → inducedFun-EM₁ f x) (boundaryHom-square d s κ)
  ∙ inducedFun-EM₁-comp (GroupIso→GroupHom (shearCoordinatesIso κ))
      (quotientHom d (shearParameter d s κ)) x

-- Only degree-one functoriality is needed to move from EM₁(ℤ²) to
-- the literal torus C×C.  The library has two induced-map
-- recursors; this comparison keeps their multiplication cells explicit.
module ClassifyingAddition {G H : AbGroup ℓ-zero} where
  B-add-recursors : (f : AbGroupHom G H) (x : EM₁ (AbGroup→Group G))
    → inducedFun-EM₁ f x ≡ inducedFun-EM {G' = G} {H' = H} f 1 x
  B-add-recursors f = EM₁.elimSet (AbGroup→Group G)
    (λ _ → emsquash _ _) refl (λ g i j → emloop (f .fst g) i)

  B-pres+ : (f : AbGroupHom G H) (x y : EM₁ (AbGroup→Group G))
    → inducedFun-EM₁ f (_+ₖ_ {G = G} {n = 1} x y)
      ≡ _+ₖ_ {G = H} {n = 1} (inducedFun-EM₁ f x) (inducedFun-EM₁ f y)
  B-pres+ f x y = B-add-recursors f (_+ₖ_ {G = G} {n = 1} x y)
    ∙ inducedFun-EM-pres+ₖ {G' = G} {H' = H} f 1 x y
    ∙ cong₂ (_+ₖ_ {G = H} {n = 1})
        (sym (B-add-recursors f x)) (sym (B-add-recursors f y))

  B-sum : (f g : AbGroupHom G H) (x : EM₁ (AbGroup→Group G))
    → inducedFun-EM₁ (addGroupHom G H f g) x
      ≡ _+ₖ_ {G = H} {n = 1} (inducedFun-EM₁ f x) (inducedFun-EM₁ g x)
  B-sum f g = EM₁.elimSet (AbGroup→Group G) (λ _ → emsquash _ _) refl
    (λ a i j → (emloop-comp (AbGroup→Group H) (f .fst a) (g .fst a)
      ∙ sym (cong₂+₁ {G = H} (emloop (f .fst a)) (emloop (g .fst a)))) j i)

open ClassifyingAddition

leftHom rightHom : GroupHom ℤGroup ℤ²Group
leftHom .fst n = n , 0
leftHom .snd = makeIsGroupHom λ _ _ → refl
rightHom .fst n = 0 , n
rightHom .snd = makeIsGroupHom λ _ _ → refl

_+B²_ : BT² → BT² → BT²
_+B²_ = _+ₖ_ {G = ℤ²Ab} {n = 1}

-- This is the classifying-space product chart.  On the two generating
-- circles it is induced by n↦(n,0) and n↦(0,n), respectively.
torusChart : T² → BT²
torusChart (a , t) = inducedFun-EM₁ leftHom a +B² inducedFun-EM₁ rightHom t

Tκ : ℤ → T² → T²
Tκ κ (a , t) = a , t +C mulC κ a

shear-leftHom : (κ : ℤ)
  → compGroupHom leftHom (GroupIso→GroupHom (shearCoordinatesIso κ))
    ≡ addGroupHom ℤAbGroup ℤ²Ab leftHom (compGroupHom (ℤHom κ) rightHom)
shear-leftHom κ = GroupHom≡ refl

shear-rightHom : (κ : ℤ)
  → compGroupHom rightHom (GroupIso→GroupHom (shearCoordinatesIso κ)) ≡ rightHom
shear-rightHom κ = GroupHom≡ (funExt λ n →
  ΣPathP (refl , cong (n +_) (·AnnihilR κ)))

BTκ-left : (κ : ℤ) (a : C)
  → BTκ κ (inducedFun-EM₁ leftHom a)
    ≡ inducedFun-EM₁ leftHom a +B² inducedFun-EM₁ rightHom (mulC κ a)
BTκ-left κ a =
  sym (inducedFun-EM₁-comp leftHom (GroupIso→GroupHom (shearCoordinatesIso κ)) a)
  ∙ cong (λ f → inducedFun-EM₁ f a) (shear-leftHom κ)
  ∙ B-sum {G = ℤAbGroup} {H = ℤ²Ab} leftHom (compGroupHom (ℤHom κ) rightHom) a
  ∙ cong (inducedFun-EM₁ leftHom a +B²_)
      (inducedFun-EM₁-comp (ℤHom κ) rightHom a)

BTκ-right : (κ : ℤ) (t : C)
  → BTκ κ (inducedFun-EM₁ rightHom t) ≡ inducedFun-EM₁ rightHom t
BTκ-right κ t =
  sym (inducedFun-EM₁-comp rightHom (GroupIso→GroupHom (shearCoordinatesIso κ)) t)
  ∙ cong (λ f → inducedFun-EM₁ f t) (shear-rightHom κ)

-- The specified coordinate formula is a map-level identity, not just
-- a calculation of the homomorphism on fundamental groups.
torusChart-shear : (κ : ℤ) (x : T²)
  → BTκ κ (torusChart x) ≡ torusChart (Tκ κ x)
torusChart-shear κ (a , t) =
  B-pres+ (GroupIso→GroupHom (shearCoordinatesIso κ))
    (inducedFun-EM₁ leftHom a) (inducedFun-EM₁ rightHom t)
  ∙ cong₂ _+B²_ (BTκ-left κ a) (BTκ-right κ t)
  ∙ sym (assocₖ {G = ℤ²Ab} 1 (inducedFun-EM₁ leftHom a)
      (inducedFun-EM₁ rightHom (mulC κ a)) (inducedFun-EM₁ rightHom t))
  ∙ cong (inducedFun-EM₁ leftHom a +B²_)
      (commₖ {G = ℤ²Ab} 1 (inducedFun-EM₁ rightHom (mulC κ a))
          (inducedFun-EM₁ rightHom t)
        ∙ sym (B-pres+ rightHom t (mulC κ a)))

boundary : (d : ℕ) (s : ℤ) → T² → BA d s
boundary d s = Bquotient d s ∘ torusChart

-- The shear on T²=C×C with Tκ(a,t)=(a,t+mulC κ a).
shearBoundary : (d : ℕ) (s κ : ℤ)
  → BΦ d s κ ∘ boundary d s
    ≡ boundary d (shearParameter d s κ) ∘ Tκ κ
shearBoundary d s κ = funExt λ x →
  funExt⁻ (shearBoundary-EM₁ d s κ) (torusChart x)
  ∙ cong (Bquotient d (shearParameter d s κ)) (torusChart-shear κ x)

-- The boundary parametrization change really is an equivalence, with
-- the forward shear map (inverse: fibre translation by -mulC κ a).
TκEquiv : (κ : ℤ) → T² ≃ T²
TκEquiv κ = Σ-cong-equiv-snd λ a →
  isoToEquiv (addIso {G = ℤAbGroup} 1 (mulC κ a))

TκEquiv-map : (κ : ℤ) → TκEquiv κ .fst ≡ Tκ κ
TκEquiv-map κ = refl

-- These compute the actual boundary map on arbitrary integer loops,
-- so the C×C boundary has exactly the homomorphism (a,b)↦[(a,b)].
torusChart-loop : (a b : ℤ)
  → cong torusChart (λ i → emloop a i , emloop b i) ≡ emloop (a , b)
torusChart-loop a b = cong₂+₁ {G = ℤ²Ab} (emloop (a , 0)) (emloop (0 , b))
  ∙ sym (emloop-comp ℤ²Group (a , 0) (0 , b))
  ∙ cong emloop (ΣPathP (refl , +Comm 0 b))

boundary-loop : (d : ℕ) (s a b : ℤ)
  → cong (boundary d s) (λ i → emloop a i , emloop b i)
    ≡ emloop (class d s (a , b))
boundary-loop d s a b = cong (cong (Bquotient d s)) (torusChart-loop a b)

projection-z : (d : ℕ) (s : ℤ) → projection d s (z d s) ≡ mod-d d 1
projection-z d s = refl

projection-h : (d : ℕ) (s : ℤ)
  → projection d s (h d s) ≡ GroupStr.1g (Cyclic d .snd)
projection-h d s = refl

-- Reparametrize both boundary legs by Tκ⁻¹.
-- This removes the common graph correction and leaves local shear s-dκ.
shearBoundary-normalized : (d : ℕ) (s κ : ℤ)
  → BΦ d s κ ∘ boundary d s ∘ invEq (TκEquiv κ)
    ≡ boundary d (shearParameter d s κ)
shearBoundary-normalized d s κ = funExt λ a →
  funExt⁻ (shearBoundary d s κ) (invEq (TκEquiv κ) a)
  ∙ cong (boundary d (shearParameter d s κ)) (secEq (TκEquiv κ) a)

-- The equivalent calculation within the SAME local group A(d,s):
-- its new preferred boundary lift is z_old h^(-κ).
preferredLift : (d : ℕ) (s κ : ℤ) → A d s .fst
preferredLift d s κ = GroupStr._·_ (A d s .snd) (z d s) (hPower d s (- κ))

inverse-shear-z : (d : ℕ) (s κ : ℤ)
  → Shear.Ψ d s κ (z d (shearParameter d s κ)) ≡ preferredLift d s κ
inverse-shear-z d s κ = cong (class d s)
  (ΣPathP (refl , cong (λ n → 0 + (- n)) (·IdR κ)))

inverse-shear-h : (d : ℕ) (s κ : ℤ)
  → Shear.Ψ d s κ (h d (shearParameter d s κ)) ≡ h d s
inverse-shear-h d s κ = cong (class d s)
  (ΣPathP (refl , cong (λ n → 1 - n) (·AnnihilR κ)))

preferred-lift-power : (d : ℕ) (s κ : ℤ)
  → (pos d ℤ[ A d s ]· preferredLift d s κ)
    ≡ ((s - pos d · κ) ℤ[ A d s ]· h d s)
preferred-lift-power d s κ =
  cong (λ a → pos d ℤ[ A d s ]· a) (sym (inverse-shear-z d s κ))
  ∙ sym (homPresℤ· (Shear.ΨHom d s κ) (z d (shearParameter d s κ)) (pos d))
  ∙ cong (Shear.Ψ d s κ) (generator-relation d (shearParameter d s κ))
